# Front web server: listens on ports 80 and 443, gets and renews the Let's Encrypt
# certificate automatically, redirects http -> https and www -> the bare domain,
# and passes requests to the site container.
# The domain comes from SITE_DOMAIN in .env.local; without it, localhost (for a test run).

{$SITE_DOMAIN:localhost} {
	encode zstd gzip
	# Caddy replaces X-Forwarded-For with the real client address and sets
	# X-Forwarded-Proto, so the site's rate limits cannot be fooled by a header.
	reverse_proxy cms-engine:3003
}

www.{$SITE_DOMAIN:localhost} {
	redir https://{$SITE_DOMAIN:localhost}{uri} permanent
}

# Domain for HTTPS in docker compose (Caddy): no https://, no www.
# SITE_DOMAIN="example.ru"

CMS_ADMIN_USERNAME="admin"
# Used only to initialize the SQLite admin account on first startup.
CMS_ADMIN_PASSWORD="replace-with-a-long-random-password"
# Keep the SQLite database on a local persistent disk in production.
# CMS_DB_PATH="data/cms.sqlite"

# Public production URL used in canonical links, sitemap.xml, and robots.txt.
# CMS_SITE_URL="https://example.com"
# CMS_SITE_NAME="Название организации"
# CMS_DEFAULT_DESCRIPTION="Краткое описание сайта для поисковой выдачи."

# Set to 1 only behind a reverse proxy that replaces X-Forwarded-For with the
# client address; otherwise rate limits and login lockout would count all
# visitors as one IP. docker-compose.yml already sets it for the Caddy setup.
# CMS_TRUST_PROXY="1"

# Limits for public endpoints (defaults shown).
# CMS_AI_LIMIT_PER_IP="20"       # AI assistant requests per IP per 10 minutes
# CMS_AI_LIMIT_PER_HOUR="300"    # AI assistant requests in total per hour
# CMS_LEAD_LIMIT_PER_IP="5"      # Bitrix leads per IP per hour
# CMS_LEAD_LIMIT_PER_HOUR="100"  # Bitrix leads in total per hour

TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
BITRIX_WEBHOOK_URL=""
OPENAI_API_KEY=""
